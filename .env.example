# ==============================================================================
# EVIDENCE-BASED MEDICAL REPORT & CHEST X-RAY INTERPRETATION SYSTEM
# Cloud-Native AI Architecture Configuration
# ==============================================================================

# Application Environment
APP_ENV=development
APP_NAME="Evidence-Based Medical AI Assistant"
API_V1_STR=/api/v1
DEBUG=True
PORT=8000
FRONTEND_URL=http://localhost:3000

# Security & Authentication
# Generate a secure key in production with: openssl rand -hex 32
JWT_SECRET=medical_ai_assistant_super_secure_cloud_secret_key_2026_dev
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Primary Cloud LLM Provider: Groq API
# Free Tier available at: https://console.groq.com
# Multi-Key Failover Pool (comma-separated): automatically rotates if any key hits rate limit (429)
LLM_PROVIDER=groq
GROQ_API_KEY=your_primary_groq_api_key_here
GROQ_API_KEYS=key1,key2,key3
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_RETRIES=2
GROQ_API_BASE_URL=https://api.groq.com/openai/v1

# Cloud Document OCR Provider
# Lossless digital PDF extraction works automatically via PyPDF with 0 external keys.
# For scanned raster images/photographs, configure Groq Vision or OCR.space free tier:
OCR_PROVIDER=cloud_ocr
OCR_API_KEY=
OCR_API_URL=https://api.ocr.space/parse/image

# Hosted Medical Imaging Inference API (Chest X-ray Analysis)
# If unconfigured, image validation and sharpness checks run safely,
# and the system transparently indicates imaging is awaiting configuration
# (STRICT SAFETY RULE: never fabricates or invents fake pathology findings).
IMAGING_PROVIDER=cloud_imaging
IMAGING_API_URL=
IMAGING_API_KEY=
IMAGING_MODEL_NAME=CheXNet-DenseNet121-Hosted
IMAGING_TIMEOUT_SECONDS=30

# Vector Database (PostgreSQL with pgvector)
# Local SQLite fallback is supported for development with in-memory semantic indexing.
# Production / Docker: postgresql://postgres:postgres@localhost:5432/medical_ai
DATABASE_URL=sqlite:///./medical_ai.sqlite
EMBEDDING_PROVIDER=cloud_embeddings
EMBEDDING_MODEL_NAME=bge-small-en-v1.5
EMBEDDING_API_URL=https://api.groq.com/openai/v1/embeddings

# Cache Configuration
REDIS_URL=redis://localhost:6379/0
USE_REDIS_CACHE=false

# Cloud Object Storage Configuration (Local or S3/R2)
STORAGE_TYPE=local
STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_MB=25
S3_BUCKET_NAME=
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# Medical Safety & Disclaimer
MEDICAL_DISCLAIMER="AI-GENERATED EDUCATIONAL SUMMARY – NOT A MEDICAL DIAGNOSIS. Consult a qualified healthcare professional for medical advice."
